{
  "name": "QuickChat Dialer",
  "short_name": "QuickChat",
  "description": "Open WhatsApp chats without saving numbers. Follow-ups, templates and backups — fully offline.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "lang": "en",
  "dir": "auto",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "portrait",
  "background_color": "#f3f5f2",
  "theme_color": "#12704a",
  "categories": ["productivity", "utilities"],
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "screenshot-chat.png",
      "sizes": "594x782",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Chat dialer: message any WhatsApp number without saving it"
    },
    {
      "src": "screenshot-followups.png",
      "sizes": "594x782",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Follow-ups: due reminders, statuses and pipeline stats"
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "file",
          "accept": [
            "application/pdf",
            ".pdf",
            "image/*"
          ]
        }
      ]
    }
  },
  "shortcuts": [
    {
      "name": "Paste number",
      "short_name": "Paste",
      "url": "./?action=paste",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Follow-ups due",
      "short_name": "Follow-ups",
      "url": "./#fu",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Follow-up queue",
      "short_name": "Follow-up",
      "url": "./#queue",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "My QR code",
      "short_name": "My QR",
      "url": "./#qr",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ]
}
